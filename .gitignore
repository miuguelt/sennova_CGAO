# --- Node.js / Frontend ---
frontend/node_modules/
node_modules/
dist/
build/
.npm
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python / Backend ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# --- Environment & Secrets ---
.env
.env.*
!.env.example
!.env.production.example
frontend/.env
backend/.env
# Vault / Secrets
.vault/
.credentials/
*.pem
*.key

# --- Databases ---
backend/sennova.db
sennova.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
# Las bases de prueba viven en un directorio temporal por corrida (tests/db_support.py).
# La regla cubre las copias antiguas que quedaron en el arbol de codigo.
test_*.db
# Pidfiles: los escriben procesos de infraestructura en la raiz del proyecto y
# quedaban sin ignorar, en estado contradictorio dentro de git.
*.pid
# Credenciales de operacion: no se versionan. Los scripts que las necesiten
# deben leerlas del entorno.
login.json
# Docker Data (Local Only)
_data/
postgres_data/
pgadmin_data/

# --- Logs ---
*.log
logs/
backend_error.log
frontend_error.log
backend.log
frontend.log
maintenance/logs/

# --- IDEs / OS Artifacts ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

