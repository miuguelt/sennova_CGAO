# ════════════════════════════════════════════════════════════════════════
# SENNOVA CGAO — Variables de Entorno PRODUCCIÓN (Coolify / VPS)
# ════════════════════════════════════════════════════════════════════════
#
# INSTRUCCIONES PARA COOLIFY:
# ─────────────────────────────
# 1. En Coolify, ve a tu Proyecto → Entorno → Variables de Entorno.
# 2. Copia cada variable (sin el #) y pega el valor real.
# 3. NUNCA commitees este archivo con valores reales al repositorio.
#
# Para generar claves seguras:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ════════════════════════════════════════════════════════════════════════

# ── Dominio Principal ──────────────────────────────────────────────────
DOMAIN=tudominio.com

# ── URLs de Aplicación ────────────────────────────────────────────────
# El frontend se sirve tras nginx, que redirige /api al backend, así que la
# ruta relativa es la opción correcta salvo que separes los dominios.
# Se hornea en el build: cambiarla exige reconstruir la imagen del frontend.
VITE_API_URL=/api
VITE_CVLAC_BASE_URL=https://scienti.minciencias.gov.co
FRONTEND_URL=https://tudominio.com
BACKEND_URL=https://tudominio.com/api

# ── Versión de la Aplicación ──────────────────────────────────────────
APP_VERSION=1.0.0
APP_NAME=SENNOVA CGAO API

# ── Seguridad (GENERAR CLAVES ÚNICAS) ─────────────────────────────────
JWT_SECRET=
JWT_EXPIRATION_HOURS=24

# ── Base de Datos PostgreSQL ──────────────────────────────────────────
DB_USER=sennova_user
DB_PASSWORD=
DB_NAME=sennova

# ── Admin Inicial (OBLIGATORIO en el primer despliegue) ───────────────
# Es el único dato de negocio que debe existir antes del primer arranque:
# grupos, semilleros, proyectos, convocatorias, retos y aprendices los crea
# después este administrador desde la interfaz.
# El entrypoint ejecuta scripts/bootstrap_initial_data.py, que es idempotente:
# en redespliegues no duplica el administrador ni reescribe su contraseña.
# Sin INITIAL_ADMIN_PASSWORD (mínimo 12 caracteres) el contenedor falla al
# arrancar; no existe contraseña por defecto.
INITIAL_ADMIN_EMAIL=admin@sena.edu.co
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NOMBRE=Administrador SENNOVA
INITIAL_ADMIN_DOCUMENTO=admin01
INITIAL_ADMIN_SEDE=CGAO
# Poblado de demostración. Es DESTRUCTIVO (borra grupos, semilleros, proyectos,
# productos, retos, convocatorias, aprendices, bitácora y los usuarios que no
# sean el admin) y por eso solo se ejecuta con DEBUG=true. En producción se
# ignora aunque esté en true.
SEED_INITIAL_DATA=false

# ── Rendimiento Uvicorn (VPS 2 vCPU / 2GB RAM) ───────────────────────
UVICORN_WORKERS=2

# ── Logs ──────────────────────────────────────────────────────────────
LOG_LEVEL=WARNING

# ── CVLAC ─────────────────────────────────────────────────────────────
CVLAC_BASE_URL=https://scienti.minciencias.gov.co

# ── SMTP (Opcional) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@sena.edu.co
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@sena.edu.co

# ── Observabilidad (opcional) ─────────────────────────────────────────
SENTRY_DSN=
