{
  "name": "sennova-cgao",
  "version": "2.0.0",
  "description": "Sistema de Gestión de Proyectos de Investigación SENNOVA CGAO",
  "type": "docker-compose",
  "services": {
    "postgres": {
      "image": "postgres:15-alpine",
      "environment": [
        "POSTGRES_DB=sennova",
        "POSTGRES_USER=sennova",
        "POSTGRES_PASSWORD=${DB_PASSWORD}"
      ],
      "volumes": [
        "postgres_data:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U sennova -d sennova"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "backend": {
      "build": {
        "context": "./backend",
        "dockerfile": "Dockerfile"
      },
      "environment": [
        "DATABASE_URL=postgresql+psycopg://sennova:${DB_PASSWORD}@postgres:5432/sennova",
        "JWT_SECRET=${JWT_SECRET}",
        "JWT_ALGORITHM=HS256",
        "JWT_EXPIRATION_HOURS=24",
        "APP_NAME=SENNOVA CGAO API",
        "DEBUG=false",
        "HOST=0.0.0.0",
        "PORT=8000",
        "INITIAL_ADMIN_EMAIL=${INITIAL_ADMIN_EMAIL:-admin@sena.edu.co}",
        "INITIAL_ADMIN_PASSWORD=${INITIAL_ADMIN_PASSWORD}",
        "ALLOWED_ORIGINS=${ALLOWED_ORIGINS:-https://sennova.enlinea.sbs,https://www.sennova.enlinea.sbs}",
        "FRONTEND_URL=${FRONTEND_URL:-https://sennova.enlinea.sbs}",
        "BACKEND_URL=${BACKEND_URL:-https://sennova.enlinea.sbs/api}"
      ],
      "ports": [
        "8000:8000"
      ],
      "depends_on": [
        "postgres"
      ],
      "volumes": [
        "sennova_storage:/app/storage"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-f",
          "http://localhost:8000/health"
        ],
        "interval": "30s",
        "timeout": "10s",
        "retries": 3
      }
    },
    "frontend": {
      "build": {
        "context": "./frontend",
        "dockerfile": "Dockerfile",
        "args": {
          "VITE_API_URL": "${VITE_API_URL:-/api}"
        }
      },
      "environment": [],
      "ports": [
        "3000:80"
      ],
      "depends_on": [
        "backend"
      ]
    },
    "backup": {
      "image": "postgres:15-alpine",
      "environment": [
        "PGPASSWORD=${DB_PASSWORD}"
      ],
      "volumes": [
        "backup_data:/backups"
      ],
      "command": "sh -c 'echo \"0 */6 * * * pg_dump -h postgres -U sennova sennova > /backups/sennova_$(date +%Y%m%d_%H%M%S).sql && find /backups -name *.sql -mtime +7 -delete\" | crontab - && crond -f'",
      "depends_on": [
        "postgres"
      ]
    }
  },
  "volumes": [
    "postgres_data",
    "backup_data",
    "sennova_storage"
  ],
  "env_variables": [
    {
      "name": "DB_PASSWORD",
      "description": "Contraseña obligatoria de PostgreSQL; configúrela como secreto en Coolify (mínimo 12 caracteres recomendado)",
      "required": true
    },
    {
      "name": "JWT_SECRET",
      "description": "Clave aleatoria obligatoria para firmar sesiones (mínimo 32 caracteres)",
      "required": true
    },
    {
      "name": "INITIAL_ADMIN_PASSWORD",
      "description": "Contraseña obligatoria para crear el administrador inicial",
      "required": true
    }
  ],
  "persistent_volumes": [
    {
      "name": "postgres_data",
      "mount_path": "/var/lib/postgresql/data",
      "description": "Datos de PostgreSQL - NO BORRAR"
    },
    {
      "name": "backup_data",
      "mount_path": "/backups",
      "description": "Backups automáticos de PostgreSQL"
    },
    {
      "name": "sennova_storage",
      "mount_path": "/app/storage",
      "description": "Almacenamiento de documentos del sistema SENNOVA"
    }
  ]
}
